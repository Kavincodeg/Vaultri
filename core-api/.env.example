# Server Configuration
SERVER_PORT=8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaultri
POSTGRES_USER=vaultri_user
POSTGRES_PASSWORD=vaultri_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Razorpay Secrets (for future payment & webhook flows)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# JWT Security
JWT_SECRET=super_secret_jwt_signing_key_min_256_bits_length_here_123456
