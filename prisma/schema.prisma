generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  plan         String     @default("free")
  createdAt    DateTime   @default(now())
  deals        Deal[]
}

model Deal {
  id             String     @id @default(cuid())
  sellerId       String
  seller         Seller     @relation(fields: [sellerId], references: [id])
  customerName   String
  customerPhone  String?
  customerEmail  String?
  description    String
  price          Int
  depositPercent Int
  dueDate        DateTime
  status         String
  contractText   String
  createdAt      DateTime   @default(now())
  payments       Payment[]
  reminders      Reminder[]
  auditLogs      AuditLog[]
}

model Payment {
  id                String   @id @default(cuid())
  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id])
  razorpayLinkId    String   @unique
  razorpayPaymentId String?  @unique
  shortUrl          String?
  type              String
  amount            Int
  status            String
  createdAt         DateTime @default(now())
}

model Reminder {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  channel   String
  message   String
  status    String    @default("scheduled")
  attempts  Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  action    String
  detail    String
  createdAt DateTime @default(now())
}
